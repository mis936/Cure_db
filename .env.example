# Google Sheets service-account credentials — the app's backend.
#
# 1. In Google Cloud Console, create (or reuse) a project, enable the "Google Sheets API",
#    then create a Service Account and generate a JSON key for it.
# 2. Open your Google Sheet and share it with the service account's email address
#    (it looks like xxx@xxx.iam.gserviceaccount.com) — give it Editor access.
# 3. Copy the three values below from the downloaded JSON key + the sheet's URL.
# 4. Duplicate this file as .env.local for local development (never commit that file),
#    and add the same three variables in Vercel → Project → Settings → Environment Variables.

# From the JSON key's "client_email" field.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# From the JSON key's "private_key" field — paste it exactly, including \n sequences and quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# The long id in your sheet's URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=1AbCDeFGhijKLmnoPQRstuVWxyz1234567890
